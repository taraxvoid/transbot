---
import { KNOWN_SETS } from '../lib/pronouns/parse'

type Props = {
    prefix: string
    legend: string
    hint?: string
    nullLabel: string
    required?: boolean
}
const { prefix, legend, hint, nullLabel, required = false } = Astro.props

// ze/hir is still reachable by typing; the picker keeps to common sets.
const PICKS = KNOWN_SETS.filter((set) => set.value !== 'ze')
const describedBy = [
    hint && `${prefix}-pronouns-hint`,
    `${prefix}-pronouns-error`,
]
    .filter(Boolean)
    .join(' ')
---

<fieldset id={`${prefix}-pronouns`} aria-describedby={describedBy}>
    <legend
        ><span id={`${prefix}-legend`}>{legend}</span>{
            required && (
                <>
                    <span class="req" aria-hidden="true">
                        {' '}
                        *
                    </span>
                    <span class="visually-hidden"> (required)</span>
                </>
            )
        }</legend
    >
    {hint && <p id={`${prefix}-pronouns-hint`} class="hint">{hint}</p>}
    <div class="picks">
        {
            PICKS.map((set) => (
                <label class="pick">
                    <input type="checkbox" name="pronoun" value={set.value} />
                    {set.label}
                </label>
            ))
        }
        <label class="pick">
            <input type="checkbox" name="pronoun" value=":void" />
            void/void's
        </label>
        <label class="pick">
            <input type="checkbox" name="pronoun" value="null" />
            {nullLabel}
        </label>
    </div>
    <label for={`${prefix}-other`}>Custom pronouns</label>
    <input
        id={`${prefix}-other`}
        autocomplete="off"
        autocapitalize="none"
        spellcheck="false"
        aria-describedby={`${prefix}-other-hint`}
    />
    <p id={`${prefix}-other-hint`} class="hint">
        Type them however you like: he/they, ne/nem, or all five forms like
        ae/aer/aer/aers/aerself.
    </p>
    <p id={`${prefix}-order`} class="hint" aria-live="polite"></p>
    <p id={`${prefix}-pronouns-error`} class="error" role="alert"></p>
</fieldset>
