---
import '../styles/global.css'

type Props = { title: string; description?: string; noindex?: boolean }
const {
    title,
    description = "Choose and practice your (or someone else's) name and pronouns.",
    noindex = false,
} = Astro.props
const ogImage = new URL('/og.png', Astro.site ?? Astro.url).href
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <meta name="referrer" content="no-referrer" />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="transbot.net" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="transbot.net: choose and practice names and pronouns" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={ogImage} />
        {noindex && <meta name="robots" content="noindex" />}
    </head>
    <body>
        <header class="site-header">
            <a href="/" class="brand">transbot.net</a>
        </header>
        <main id="main">
            <slot />
        </main>
        <footer class="site-footer">
            <p>
                Pronoun conjugations from <a href="https://en.pronouns.page">pronouns.page</a> used under the <a href="https://en.pronouns.page/license"
                    >Opinionated Queer License v1.4</a
                >. This site is not affiliated with pronouns.page.
            </p>
        </footer>
    </body>
</html>
