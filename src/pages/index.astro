---
import PronounPicker from '../components/PronounPicker.astro'
import Layout from '../layouts/Layout.astro'
---

<Layout title="transbot">
    <section aria-labelledby="builder-heading">
        <h1 id="builder-heading">Choose Name / Pronouns</h1>
        <p class="hint"><span class="req" aria-hidden="true">*</span> Required</p>
        <form id="builder" novalidate aria-labelledby="builder-heading">
            <label for="b-name"
                >Name <span class="req" aria-hidden="true">*</span></label
            >
            <input
                id="b-name"
                autocomplete="off"
                required
                aria-describedby="b-name-error"
            />
            <p id="b-name-error" class="error" role="alert"></p>
            <PronounPicker
                prefix="b"
                legend="Pronouns"
                nullLabel="No pronouns, just my name"
                required
            />
            <p id="builder-status" class="error" role="alert"></p>
            <button type="submit" id="builder-submit">Submit</button>
        </form>
    </section>

    <section aria-labelledby="card-heading">
        <h2 id="card-heading">Already on pronouns.page?</h2>
        <p>
            Enter your username or paste your profile link instead. Your
            transbot link follows your card, so changes you make there show up
            within about an hour.
        </p>
        <div id="return-prompt" hidden>
            <p>Made your card? Enter your username to get your link.</p>
            <button type="button" id="not-now" class="secondary"
                >Not now</button
            >
        </div>
        <!-- Without JavaScript, /profile?username= redirects on its own. -->
        <form
            id="card-form"
            method="get"
            action="/profile"
            novalidate
            aria-labelledby="card-heading"
        >
            <label for="username"
                >pronouns.page username or link <span
                    class="req"
                    aria-hidden="true">*</span
                ></label
            >
            <input
                id="username"
                name="username"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
                required
                aria-describedby="card-result"
            />
            <p id="card-result" class="error" role="alert"></p>
            <button type="submit" id="card-submit">Submit</button>
        </form>
        <p class="hint">
            Not on pronouns.page? The form above is all you need. If you'd
            like a card anyway, <a
                id="setup-link"
                href="https://en.pronouns.page/account"
                target="_blank"
                rel="noopener">set up a pronouns.page card</a
            > (opens in a new tab) and come back here.
        </p>
    </section>

    <section aria-labelledby="got-link-heading">
        <h2 id="got-link-heading">Got a link from someone?</h2>
        <p>Open it to start practicing. There's nothing to set up.</p>
    </section>
</Layout>

<script>
    import '../scripts/landing'
</script>
