---
import Layout from '../layouts/Layout.astro'
import { KNOWN_SETS } from '../lib/pronouns/parse'

// ze/hir is still reachable by typing; the picker keeps to common sets.
const PICKS = KNOWN_SETS.filter((set) => set.value !== 'ze')
---

<Layout title="transbot">
    <section>
        <h1>Practice someone's name and pronouns</h1>
        <p>
            Someone shared this site so you can get comfortable with a name and
            pronouns before you talk. You fill in short sentences, and
            transbot shows the right form each time. Nobody keeps score.
        </p>
        <p>
            Got a link from a friend? Open it and start. Want a link for
            yourself? Make one below.
        </p>
    </section>

    <section aria-labelledby="share-heading">
        <h2 id="share-heading">Make your own link</h2>
        <div class="choices">
            <button
                type="button"
                id="have-card"
                class="secondary"
                aria-expanded="false"
                aria-controls="card-panel">I have a pronouns.page card</button
            >
            <button
                type="button"
                id="no-card"
                class="secondary"
                aria-expanded="false"
                aria-controls="setup-panel">I don't have one yet</button
            >
        </div>

        <div id="setup-panel" hidden>
            <p>
                <a
                    id="setup-link"
                    href="https://en.pronouns.page/account"
                    target="_blank"
                    rel="noopener">Set up your pronouns.page card</a
                > (opens in a new tab).
            </p>
            <p>The link builder below works without an account.</p>
        </div>

        <div id="card-panel" hidden>
            <div id="return-prompt" hidden>
                <p>Made your card? Enter your username to get your link.</p>
                <button type="button" id="not-now" class="secondary"
                    >Not now</button
                >
            </div>
            <label for="username">pronouns.page username</label>
            <input
                id="username"
                autocomplete="off"
                autocapitalize="none"
                spellcheck="false"
            />
            <div id="card-result" aria-live="polite"></div>
        </div>
    </section>

    <section aria-labelledby="builder-heading">
        <h2 id="builder-heading">Link builder</h2>
        <p class="hint">
            No account needed. The name stays in the link and never reaches
            transbot's server.
        </p>
        <form id="builder">
            <label for="b-name">Name</label>
            <input id="b-name" autocomplete="off" />
            <fieldset id="b-pronouns" aria-describedby="b-pronouns-hint">
                <legend>Pronouns</legend>
                <p id="b-pronouns-hint" class="hint">
                    Pick all that apply. The first one you pick is used in the
                    practice sentences.
                </p>
                <div class="picks">
                    {
                        PICKS.map((set) => (
                            <label class="pick">
                                <input
                                    type="checkbox"
                                    name="pronoun"
                                    value={set.value}
                                />
                                {set.label}
                            </label>
                        ))
                    }
                    <label class="pick">
                        <input type="checkbox" name="pronoun" value="null" />
                        No pronouns, just my name
                    </label>
                </div>
                <label for="b-other">Other pronouns</label>
                <input
                    id="b-other"
                    autocomplete="off"
                    autocapitalize="none"
                    spellcheck="false"
                    aria-describedby="b-other-hint"
                />
                <p id="b-other-hint" class="hint">
                    Type them however you like: he/they, ne/nem, or all five
                    forms like ae/aer/aer/aers/aerself.
                </p>
                <p id="b-order" class="hint" aria-live="polite"></p>
            </fieldset>
            <div id="builder-result" aria-live="polite"></div>
        </form>
    </section>
</Layout>

<script>
    import '../scripts/landing'
</script>
