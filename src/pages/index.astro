---
import Layout from '../layouts/Layout.astro'
import { KNOWN_SETS } from '../lib/pronouns/parse'

// ze/hir is still reachable by typing; the picker keeps to common sets.
const PICKS = KNOWN_SETS.filter((set) => set.value !== 'ze')
---

<Layout title="transbot">
    <section>
        <h1>Help the people in your life get your name and pronouns right</h1>
        <p>
            Enter your name and pronouns to get a link. Send it to family,
            friends or coworkers, and they can practice with short
            fill-in-the-blank sentences before they talk to you. transbot
            shows the right form each time, and nobody keeps score.
        </p>
    </section>

    <section aria-labelledby="builder-heading">
        <h2 id="builder-heading">Make your link</h2>
        <p class="hint">
            No account needed. The name is part of the link, so transbot's
            server can see it. Nothing is stored.
        </p>
        <form id="builder">
            <label for="b-name">Your name</label>
            <input id="b-name" autocomplete="off" />
            <fieldset id="b-pronouns" aria-describedby="b-pronouns-hint">
                <legend>Your pronouns</legend>
                <p id="b-pronouns-hint" class="hint">
                    Pick all that apply. The first one you pick is used in the
                    practice sentences.
                </p>
                <div class="picks">
                    {
                        PICKS.map((set) => (
                            <label class="pick">
                                <input
                                    type="checkbox"
                                    name="pronoun"
                                    value={set.value}
                                />
                                {set.label}
                            </label>
                        ))
                    }
                    <label class="pick">
                        <input type="checkbox" name="pronoun" value="null" />
                        No pronouns, just my name
                    </label>
                </div>
                <label for="b-other">Other pronouns</label>
                <input
                    id="b-other"
                    autocomplete="off"
                    autocapitalize="none"
                    spellcheck="false"
                    aria-describedby="b-other-hint"
                />
                <p id="b-other-hint" class="hint">
                    Type them however you like: he/they, ne/nem, or all five
                    forms like ae/aer/aer/aers/aerself.
                </p>
                <p id="b-order" class="hint" aria-live="polite"></p>
            </fieldset>
            <div id="builder-result" aria-live="polite"></div>
        </form>
    </section>

    <section aria-labelledby="card-heading">
        <h2 id="card-heading">Already on pronouns.page?</h2>
        <p>
            Enter your username or paste your profile link instead. Your
            transbot link follows your card, so changes you make there show up
            within about an hour.
        </p>
        <div id="return-prompt" hidden>
            <p>Made your card? Enter your username to get your link.</p>
            <button type="button" id="not-now" class="secondary"
                >Not now</button
            >
        </div>
        <label for="username">pronouns.page username or link</label>
        <input
            id="username"
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
        />
        <div id="card-result" aria-live="polite"></div>
        <p class="hint">
            Not on pronouns.page? The form above is all you need. If you'd
            like a card anyway, <a
                id="setup-link"
                href="https://en.pronouns.page/account"
                target="_blank"
                rel="noopener">set up a pronouns.page card</a
            > (opens in a new tab) and come back here.
        </p>
    </section>

    <section aria-labelledby="got-link-heading">
        <h2 id="got-link-heading">Got a link from someone?</h2>
        <p>Open it to start practicing. There's nothing to set up.</p>
    </section>
</Layout>

<script>
    import '../scripts/landing'
</script>
