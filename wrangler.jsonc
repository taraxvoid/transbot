{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "transbot",
    "account_id": "c6a445a43a801403a8e33968be40c19c",
    "compatibility_date": "2026-09-01",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS"
    },
    "vars": {
        // e2e overrides this with a local fixture server (scripts/e2e-preview.ts)
        "PRONOUNS_API_BASE": "https://en.pronouns.page/api/public/v3"
    },
    // Off on purpose: nothing about practice sessions is logged (see spec, Privacy).
    "observability": {
        "enabled": false
    },
    // PR previews live under a separate Worker, "transbot-preview", so the token
    // CI uses for them has no rights on prod (see ci.yml, voidflow#405). No routes.
    // Create it once with your own login: `wrangler deploy --env preview`.
    "env": {
        "preview": {
            "workers_dev": true,
            "routes": [],
            "vars": {
                "PRONOUNS_API_BASE": "https://en.pronouns.page/api/public/v3"
            },
            "observability": {
                "enabled": false
            },
            "previews": {
                "vars": {
                    "PRONOUNS_API_BASE": "https://en.pronouns.page/api/public/v3"
                },
                "observability": {
                    "enabled": false
                }
            }
        }
    },
    "routes": [
        {
            "pattern": "transbot.net",
            "custom_domain": true
        }
    ]
}
